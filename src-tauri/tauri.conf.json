{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAFD Reader",
  "version": "0.1.0",
  "identifier": "org.caf.reader",
  "build": {
    "beforeDevCommand": "npm run host:build",
    "beforeBuildCommand": "npm run host:build",
    "frontendDist": "../dist-host"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: cafcover: http://cafcover.localhost; font-src 'self' blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost cafbook: http://cafbook.localhost; worker-src 'self'; frame-src 'self' about:; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ],
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cafd"
        ],
        "name": "CAFD 交互文档",
        "description": "CAFD 交互文档",
        "mimeType": "application/x-cafd",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "org.caf.document",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
